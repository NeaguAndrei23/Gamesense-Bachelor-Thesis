@model List<GameSense.Web.Models.SessionViewModel>
@{
    ViewData["Title"] = "Level Details";
    var difficulty = ViewBag.DifficultyResponse as GameSense.Web.Models.DifficultyPredictionViewModel;
    var difficultyLabel = difficulty?.PredictedDifficulty ?? "Unavailable";
    var badgeColor = difficultyLabel switch
    {
        "Easy" => "success",
        "Medium" => "warning",
        "Hard" => "danger",
        "Unfair" => "dark",
        _ => "secondary"
    };
}

@* navbar *@
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container-fluid px-4">
        <span class="navbar-brand fw-bold text-primary fs-4">GameSense</span>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/Sessions"> Back to the Sessions list</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 py-4">

    @* page header *@
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="h2 fw-bold mb-0">@ViewBag.LevelId</h1>
        <span class="badge bg-@badgeColor fs-6">@difficultyLabel</span>
    </div>
    @{
        var levelConfig = ViewBag.LevelConfig as GameSense.Web.Models.LevelConfigViewModel;
        var intended = levelConfig?.ExpectedDifficulty;
        var isTrainingLevel = ((string)ViewBag.LevelId).StartsWith("TrainingLevel_");
    }

    @* Difficulty mismatch warning *@

    @if (isTrainingLevel)
    {
        <div class="alert alert-secondary mt-2">
            This is a training reference level used to teach the difficulty prediction model — its configured difficulty is ground truth data, not a live designer assessment.
        </div>
    }
    else if (intended != null && difficultyLabel != "Unavailable")
    {
        if (intended == difficultyLabel)
        {
                    <div class="alert alert-success mt-2">
                        Player behavior matches your intended difficulty of
                        <strong>@intended</strong>
                    </div>
        }
        else
        {
                    <div class="alert alert-warning mt-2">
                        Mismatch detected —
                        Intended: <strong>@intended</strong> |
                        Predicted by players: <strong>@difficultyLabel</strong>
                    </div>
        }
    }
    else if (intended == null)
    {
            <div class="alert alert-secondary mt-2">
                No intended difficulty configured for this level.
                <a asp-controller="LevelConfig" asp-action="Configure" asp-route-levelId="@ViewBag.LevelId">Configure now</a>
            </div>
    }
    @* stat cards *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small text-uppercase fw-semibold mb-1">Total Sessions</p>
                    <p class="fs-3 fw-bold mb-0">@Model.Count</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small text-uppercase fw-semibold mb-1">Average Deaths</p>
                    <p class="fs-3 fw-bold mb-0">@(Model.Any() ? Model.Average(s => s.Deaths).ToString("F1") : "0")</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small text-uppercase fw-semibold mb-1">Average Duration</p>
                    <p class="fs-3 fw-bold mb-0">@(Model.Any() ? Model.Average(s => s.DurationSeconds).ToString("F1") : "0")s</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small text-uppercase fw-semibold mb-1">Completion Rate</p>
                    <p class="fs-3 fw-bold mb-0 text-primary">
                        @(Model.Count == 0 ? 0 : Model.Count(s => s.IsCompleted) * 100 / Model.Count)%
                    </p>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar" style="width: @(Model.Count == 0 ? 0 : Model.Count(s => s.IsCompleted) * 100 / Model.Count)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* zone table and chart *@
    <div class="row g-3">
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Zone Fatalities</div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Zone Name</th>
                                <th class="text-end">Death Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var zone in (List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats)
                            {
                                    <tr>
                                        <td>@zone.Zone</td>
                                        <td class="text-end fw-bold">@zone.DeathCount</td>
                                    </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Deaths per Zone</div>
                <div class="card-body">
                    <canvas id="zoneChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* chart.js *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('zoneChart').getContext('2d');
    const chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
         ((List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats).Select(z => z.Zone)
            )),
            datasets: [{
                label: 'Deaths per Zone',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
           ((List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats).Select(z => z.DeathCount)
                )),
                backgroundColor: [
                    'rgba(13, 110, 253, 0.7)',
                    'rgba(220, 53, 69, 0.7)',
                    'rgba(255, 193, 7, 0.7)',
                    'rgba(25, 135, 84, 0.7)',
                    'rgba(108, 117, 125, 0.7)'
                ]
            }]
        },
        options: {
            scales: {
                y: {
                    ticks: { stepSize: 1, precision: 0 },
                    beginAtZero: true
                }
            }
        }
    });
</script>