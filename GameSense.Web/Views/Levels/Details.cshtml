@model List<GameSense.Web.Models.SessionViewModel>
@{
	ViewData["Title"] = "Zone Statistics";
}

<h2>@ViewBag.LevelId - level details</h2>
<div>
	<p>Total Sessions: @Model.Count</p>
	<p>Average Deaths: @(Model.Average(s => s.Deaths).ToString("F1"))</p>
	<p>Average Duration: @(Model.Average(s => s.DurationSeconds).ToString("F1"))s</p>
	<p>Completion Rate: @(Model.Count == 0 ? 0 : Model.Count(s => s.IsCompleted) * 100 / Model.Count)%</p>
</div>

<table class="table">
	<thead>
		<tr>
			<th>Zone</th>
			<th>Deaths</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var zone in (List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats)
		{
			<tr>
				<td>@zone.Zone</td>
				<td>@zone.DeathCount</td>
			</tr>
		}
	</tbody>
</table>
<canvas id="zoneChart" width="400" height="200"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
	const ctx = document.getElementById('zoneChart').getContext('2d');
	const chart = new Chart(ctx, {
		type: 'bar',
		data: {
			labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
						((List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats).Select(z => z.Zone)
					)),
			datasets: [{
				label: 'Deaths per Zone',
				data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
					((List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats).Select(z => z.DeathCount)
				)),
				backgroundColor: 'rgba(255, 99, 132, 0.5)'
			}]
		},
		options: {
			scales: {
				y: {
					ticks: {
						stepSize: 1,
						precision: 0
					},
					beginAtZero: true
				}
			}
		}		
	});
</script>