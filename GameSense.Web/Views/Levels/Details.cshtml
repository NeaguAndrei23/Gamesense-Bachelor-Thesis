@model List<GameSense.Web.Models.SessionViewModel>
@{
    ViewData["Title"] = "Zone Statistics";
}

@* page heading showing which level is being analyzed *@
<h2>@ViewBag.LevelId - level details</h2>
@* difficulty prediction from ML model *@
@if (ViewBag.DifficultyResponse != null)
{
    <div>
        @{
            var difficulty = ViewBag.DifficultyResponse as GameSense.Web.Models.DifficultyPredictionViewModel;
        }
        @if (difficulty != null)
        {
            <div>
                <strong>Predicted Difficulty: </strong> @difficulty.PredictedDifficulty
            </div>
        }
        else
        {
            <div>
                <strong>Predicted Difficulty: </strong> Unavailable (add more session data)
            </div>
        }
    </div>
}
else
{
    <div>
        <strong>Predicted Difficulty: </strong> Unavailable (add more session data)
    </div>
}
@* aggregated statistics calculated from all sessions for this level *@
<div>
    <p>Total Sessions: @Model.Count</p>
    <p>Average Deaths: @(Model.Average(s => s.Deaths).ToString("F1"))</p>
    <p>Average Duration: @(Model.Average(s => s.DurationSeconds).ToString("F1"))s</p>
    @* completion rate: sessions completed / total sessions, guarded against division by zero *@
    <p>Completion Rate: @(Model.Count == 0 ? 0 : Model.Count(s => s.IsCompleted) * 100 / Model.Count)%</p>
</div>

@* zone death count table — shows how many deaths occurred in each designer-defined zone *@
<table class="table">
    <thead>
        <tr>
            <th>Zone</th>
            <th>Deaths</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var zone in (List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats)
        {
                <tr>
                    <td>@zone.Zone</td>
                    <td>@zone.DeathCount</td>
                </tr>
        }
    </tbody>
</table>

@* bar chart visualizing deaths per zone using Chart.js *@
<canvas id="zoneChart" width="400" height="200"></canvas>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('zoneChart').getContext('2d');
    const chart = new Chart(ctx, {
        type: 'bar',
        data: {
            // zone names as x-axis labels, serialized from server-side Razor data
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
         ((List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats).Select(z => z.Zone)
            )),
            datasets: [{
                label: 'Deaths per Zone',
                // death counts as y-axis values, serialized from server-side Razor data
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
           ((List<GameSense.Web.Models.ZoneStatViewModel>)ViewBag.ZoneStats).Select(z => z.DeathCount)
                )),
                backgroundColor: 'rgba(255, 99, 132, 0.5)'
            }]
        },
        options: {
            scales: {
                y: {
                    ticks: {
                        stepSize: 1,    // force integer steps — deaths are always whole numbers
                        precision: 0
                    },
                    beginAtZero: true
                }
            }
        }
    });
</script>