@model List<GameSense.Web.Models.SessionViewModel>
@{
    ViewData["Title"] = "Sessions";
    int i = 1;
}

@* navbar *@
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container-fluid px-4">
        <span class="navbar-brand fw-bold text-primary fs-4">GameSense</span>

    </div>
</nav>

<div class="container-fluid px-4 py-4">

    @* page header *@
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h2 fw-bold mb-0">Playtesting Sessions</h1>
            <p class="text-muted mb-0">@Model.Count total sessions recorded</p>
        </div>
    </div>

    @* sessions table *@
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">#</th>
                        <th class="px-4 py-3">Player</th>
                        <th class="px-4 py-3">Level</th>
                        <th class="px-4 py-3">Date & Time</th>
                        <th class="px-4 py-3">Duration (s)</th>
                        <th class="px-4 py-3">Deaths</th>
                        <th class="px-4 py-3">Attempts</th>
                        <th class="px-4 py-3">Completed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                            <tr>
                                <td class="px-4 py-3 text-muted">@i</td>
                                <td class="px-4 py-3 fw-semibold">@session.PlayerId</td>
                                <td class="px-4 py-3">
                                    <a asp-controller="Levels" asp-action="Details" asp-route-levelId="@session.LevelId"
                                       class="text-primary text-decoration-none fw-semibold">
                                    @session.LevelId
                                    </a>
                                </td>
                                <td class="px-4 py-3 text-muted">@session.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-4 py-3">@session.DurationSeconds</td>
                                <td class="px-4 py-3">
                                    <span class="badge @(session.Deaths > 5 ? "bg-danger" : session.Deaths > 2 ? "bg-warning text-dark" : "bg-success")">
                                    @session.Deaths
                                    </span>
                                </td>
                                <td class="px-4 py-3">@session.Attempts</td>
                                <td class="px-4 py-3">
                                @if (session.IsCompleted)
                                {
                                            <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                            <span class="badge bg-secondary">No</span>
                                }
                                </td>
                            </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>