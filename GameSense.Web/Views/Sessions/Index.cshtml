@model List<GameSense.Web.Models.LevelSummaryViewModel>
@{
    ViewData["Title"] = "Levels Overview";
}

@* navbar *@
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container-fluid px-4">
        <span class="navbar-brand fw-bold text-primary fs-4">GameSense</span>
    </div>
</nav>

<div class="container-fluid px-4 py-4">
    @* page header *@
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h2 fw-bold mb-0">Levels Overview</h1>
            <p class="text-muted mb-0">@Model.Count levels tracked</p>
        </div>
    </div>

    @* levels table *@
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">Level</th>
                        <th class="px-4 py-3">Sessions</th>
                        <th class="px-4 py-3">Avg Deaths</th>
                        <th class="px-4 py-3">Avg Duration (seconds)</th>
                        <th class="px-4 py-3">Completion Rate</th>
                        <th class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var level in Model)
                    {
                            <tr>
                                <td class="px-4 py-3 fw-semibold">
                                    <a asp-controller="Levels" asp-action="Details" asp-route-levelId="@level.LevelId"
                                       class="text-primary text-decoration-none">
                                    @level.LevelId
                                    </a>
                                </td>
                                <td class="px-4 py-3">@level.SessionCount</td>
                                <td class="px-4 py-3">
                                    <span class="badge @(level.AverageDeaths > 5 ? "bg-danger" : level.AverageDeaths > 2 ? "bg-warning text-dark" : "bg-success")">
                                    @level.AverageDeaths.ToString("F1")
                                    </span>
                                </td>
                                <td class="px-4 py-3">@level.AverageDuration.ToString("F1")</td>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar" style="width: @level.CompletionRate%"></div>
                                        </div>
                                        <span class="text-muted small">@level.CompletionRate%</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                @if (!new[] { "Level_1", "Level_2", "Level_3", "Level_4", "Level_5" }.Contains(level.LevelId))
                                {
                                    <a asp-controller="LevelConfig" asp-action="Configure" 
                                    asp-route-levelId="@level.LevelId"
                                    class="btn btn-sm btn-outline-secondary">
                                        Configure
                                </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Training data</span>
                                }
                                </td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>