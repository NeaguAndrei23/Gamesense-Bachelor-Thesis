@model GameSense.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="container-fluid px-4 py-4">
    <h1 class="text-danger">An error occurred</h1>
    <p class="text-muted">Something went wrong while processing your request.</p>
    @if (Model?.ShowRequestId == true)
    {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</div>